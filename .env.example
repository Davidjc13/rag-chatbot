APP_NAME=RAG Chatbot
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false
HOST=0.0.0.0
PORT=8000

# Proveedor: litellm | ollama | mock
LLM_PROVIDER=litellm

# LiteLLM — modelo en formato proveedor/modelo, p.ej.:
#   ollama/qwen2.5:3b | ollama/llama3.2:3b | openai/gpt-4o-mini | anthropic/claude-3-5-sonnet-latest
LITELLM_MODEL=ollama/qwen2.5:3b
LITELLM_API_BASE=http://localhost:11434
# LITELLM_API_KEY=sk-...
LITELLM_TIMEOUT_SECONDS=120
LITELLM_TEMPERATURE=0.7

# Embeddings (RAG)
LITELLM_EMBEDDING_MODEL=ollama/nomic-embed-text
LITELLM_EMBEDDING_TIMEOUT_SECONDS=60

# Chunking / retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RAG_TOP_K=4
# Score mínimo de similitud para considerar la consulta dentro del alcance documental
RAG_MIN_SCORE=0.25

# Ollama directo (solo si LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_TEMPERATURE=0.7

SYSTEM_PROMPT=Eres un asistente de documentos. Responde solo con información presente en el contexto RAG proporcionado. Si la pregunta no se puede responder con ese contexto, indícalo con claridad y no inventes. No respondas temas ajenos a los documentos ni uses lenguaje ofensivo. Responde en el mismo idioma en que te escriben, de forma clara y concisa.
