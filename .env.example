APP_NAME=RAG Chatbot
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=false
HOST=0.0.0.0
PORT=8000

# PostgreSQL + pgvector
DATABASE_URL=postgresql+asyncpg://chatbot:chatbot@localhost:5433/chatbot
EMBEDDING_DIMENSION=768
VECTOR_BACKEND=postgres

# Neo4j (flujo alternativo de retrieval; Postgres sigue siendo el principal)
NEO4J_ENABLED=true
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
NEO4J_VECTOR_INDEX=chunk_embeddings
NEO4J_EMBEDDING_DIMENSION=768

# Proveedor: litellm | ollama | mock
LLM_PROVIDER=ollama

# LiteLLM (chat si LLM_PROVIDER=litellm; embeddings siempre vía LiteLLM)
LITELLM_MODEL=ollama/qwen3:4b
LITELLM_API_BASE=http://localhost:11434
# LITELLM_API_KEY=sk-...
LITELLM_TIMEOUT_SECONDS=120
LITELLM_TEMPERATURE=0.7
LITELLM_EMBEDDING_MODEL=ollama/nomic-embed-text
LITELLM_EMBEDDING_TIMEOUT_SECONDS=60

# Chunking / retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=100
RAG_TOP_K=4
RAG_MIN_SCORE=0.25

# Ollama directo — con LLM_PROVIDER=ollama, chat Y embeddings usan esta URL
# Local: http://localhost:11434
# Docker Compose (--profile docker): http://ollama:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_TEMPERATURE=0.7
OLLAMA_THINK=true
OLLAMA_NUM_PREDICT=4096
OLLAMA_THINK_MAX_CHARS=600

# Cliente HTTP compartido
HTTP_TIMEOUT_SECONDS=120

# Speech-to-text (entrada por voz)
STT_ENABLED=true
STT_PROVIDER=faster_whisper
STT_MODEL=base
STT_LANGUAGE=es
STT_MAX_AUDIO_SECONDS=60

# DeepEval (evaluaciones en /evals y python -m evals)
# Juez local: usa OllamaModel con think=false (qwen3:4b funciona; LiteLLM suele fallar el JSON)
# DEEPEVAL_JUDGE_MODEL=qwen3:4b
# Timeout por métrica/muestra (DeepEval usa 180s por defecto; insuficiente con Ollama local)
DEEPEVAL_PER_TASK_TIMEOUT_SECONDS_OVERRIDE=600
DEEPEVAL_TELEMETRY_OPT_OUT=YES
DEEPEVAL_DISABLE_DOTENV=1

# Los prompts system ({context}) y user_message ({question}) se seedan en BD (tabla prompts).

# Langfuse (observabilidad LLM). UI: http://localhost:3300
# Levantar stack: make langfuse-up
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-rag-dev
LANGFUSE_SECRET_KEY=sk-lf-rag-dev
# Host local (navegador): http://localhost:3300 | Docker chatbot: http://langfuse-web:3000
LANGFUSE_HOST=http://localhost:3300
LANGFUSE_INIT_ORG_ID=rag-chatbot-org
LANGFUSE_INIT_PROJECT_ID=rag-chatbot-project
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_PASSWORD=adminadmin
